{
  "name": "boilerplare",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "types:generate": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB",
    "typecheck": "tsc",
    "check": "ultracite check --type-aware --deny-warnings --format=agent && bun run typecheck",
    "fix": "ultracite fix --type-aware --deny-warnings --format=agent"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hono/standard-validator": "^0.4.1",
    "awilix": "^13.0.5",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^1.0.0-rc.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~7.0.2",
    "ultracite": "8.1.0",
    "wrangler": "^4.156.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
