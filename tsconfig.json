{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
